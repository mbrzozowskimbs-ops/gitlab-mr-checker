{
	"manifest_version": 2,
	"name": "Gitlab MR Checker",
	"version": "1.4.0",
	"author": "Marek Brzozowski",
	"description": "Sprawdza usuwanie brancha i squash przy zapisie i ręcznym merge MR. Nie obejmuje automatic merge. Autor: Marek Brzozowski.",
	"browser_specific_settings": {
		"gecko": {
			"id": "gitlab-mr-options-guard@local.invalid",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"permissions": ["storage"],
	"optional_permissions": ["https://*/*"],
	"icons": {
		"48": "icons/icon-48.png",
		"96": "icons/icon-96.png",
		"128": "icons/icon-128.png"
	},
	"background": { "scripts": ["settings.js", "background.js"] },
	"options_ui": { "page": "options.html", "open_in_tab": true },
	"browser_action": {
		"default_title": "Gitlab MR Checker — ustawienia",
		"default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
	}
}
